# TezAtlas çoklu ajan sistemi: API anahtarları
# Bu dosyayı .env adıyla kopyalayın ve kullanacağınız anahtarları doldurun.
# Yalnız agents.yaml'da kullandığınız sağlayıcıların anahtarı gerekir.
# .env dosyası git'e eklenmez; anahtarınız bilgisayarınızda kalır.

# Önerilen: tek anahtarla birden çok sağlayıcının modeli (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# İsteğe bağlı model değişikliği (ör. anthropic/claude-sonnet-5.5)
# OPENROUTER_MODEL=

# Akademik API'ler için iletişim e-postası (Crossref/OpenAlex "polite pool")
# TEZATLAS_MAILTO=adiniz@universite.edu.tr

# OpenAI
OPENAI_API_KEY=

# Google Gemini (via OpenAI-compatible endpoint)
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Anthropic (uses separate SDK, not OpenAI-compatible)
ANTHROPIC_API_KEY=

# Grok (xAI)
GROK_API_KEY=

# Groq
GROQ_API_KEY=

# Together AI
TOGETHER_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# Custom provider (add your own):
# CUSTOM_PROVIDER_API_KEY=
# CUSTOM_PROVIDER_BASE_URL=
# CUSTOM_PROVIDER_MODEL=
